# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Option 1: Direct Connection URL (Recommended for cloud/remote MySQL or PostgreSQL)
# Example: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?ssl_mode=REQUIRED
DATABASE_URL=

# Option 2: Fallback Individual Parameters (used if DATABASE_URL is not set)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ============================================================
# SECURITY & AUTHENTICATION SECRETS
# ============================================================
# Application secret key for session signing and security operations
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT secret key for signing authentication tokens
JWT_SECRET=

# JWT configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================
# FRONTEND & CORS CONFIGURATION
# ============================================================
# URL of your frontend (e.g., https://your-app.onrender.com or https://your-app.vercel.app)
# Multiple origins can be comma-separated
FRONTEND_URL=